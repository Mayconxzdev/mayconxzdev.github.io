* text=auto eol=lf
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.gif binary
*.svg -text
*.woff2 binary
*.ttf binary
public/assets/fonts/*-OFL.txt -whitespace

# Release artifacts keep exact reviewed bytes on all platforms.
site-release/** -text whitespace=cr-at-eol,-blank-at-eol
